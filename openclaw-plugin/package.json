    "channel": {
      "id": "aicq-chat",
      "label": "AICQ Encrypted Chat",
      "blurb": "\u7aef\u5230\u7aef\u52a0\u5bc6\u5373\u65f6\u901a\u8baf\u9891\u9053\uff0c\u57fa\u4e8e NaCl (X25519 + XSalsa20-Poly1305)",
      "icon": "\ud83d\udd10"
    }
  },
  "optionalDependencies": {
    "aicq-sdk": ">=1.0.0"
  }
}
