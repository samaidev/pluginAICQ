{
  "name": "aicq-openclaw",
  "version": "3.16.5",
  "description": "AICQ End-to-end Encrypted Chat Channel Plugin for OpenClaw \u2014 In-process Channel SDK architecture with friend management, group chat, file transfer, and AI agent communication",
  "type": "module",
  "main": "index.js",
  "bin": {
    "aicq-plugin": "cli.cjs"
  },
  "files": [
    "index.js",
    "setup-entry.js",
    "cli.cjs",
    "postinstall.cjs",
    "src/",
    "lib/",
    "public/",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js",
    "postinstall": "node postinstall.cjs",
    "install-deps": "npm install"
  },
  "keywords": [
    "aicq",
    "chat",
    "encrypted",
    "e2ee",
    "openclaw",
    "plugin",
    "channel",
    "ai-agent",
    "messaging",
    "p2p"
  ],
  "author": "samaidev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samaidev/aicq.git",
    "directory": "pluginAICQ/openclaw-plugin"
  },
  "bugs": {
    "url": "https://github.com/samaidev/aicq/issues"
  },
  "homepage": "https://aicq.me",
  "dependencies": {
    "express": "^5.1.0",
    "marked": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.3",
    "sql.js": "^1.14.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "setupEntry": "./setup-entry.js",
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
